---
// Theme picker: a dependency-free port of the previous shadcn/Radix
// DropdownMenu. Classes match the old Button (outline, icon) and
// DropdownMenuContent/DropdownMenuItem exactly, and the script mirrors Radix's
// keyboard and pointer behaviour, minus its modal scroll lock.
const buttonClass =
  'inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-hidden focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground h-9 w-9'

const menuClass =
  'inset-auto m-0 min-w-[8rem] overflow-hidden rounded-md border bg-popover p-1 text-popover-foreground shadow-md outline-hidden data-[side=bottom]:slide-in-from-top-2 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95'

const itemClass =
  'relative flex cursor-default items-center rounded-sm px-2 py-1.5 text-sm outline-hidden transition-colors select-none focus:bg-accent focus:text-accent-foreground'

const themes = [
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
  { value: 'system', label: 'System' },
]
---

<button
  id="theme-toggle"
  type="button"
  class={buttonClass}
  aria-haspopup="menu"
  aria-expanded="false"
  aria-controls="theme-menu"
  data-state="closed"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="h-[1.2rem] w-[1.2rem] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="absolute h-[1.2rem] w-[1.2rem] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"
    aria-hidden="true"
  >
    <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path>
  </svg>
  <span class="sr-only">Toggle theme</span>
</button>

<div
  id="theme-menu"
  popover="manual"
  role="menu"
  aria-orientation="vertical"
  aria-labelledby="theme-toggle"
  tabindex="-1"
  data-side="bottom"
  data-align="end"
  data-state="closed"
  class={menuClass}
>
  {themes.map(({ value, label }) => (
    <div role="menuitem" tabindex="-1" data-theme={value} class={itemClass}>
      {label}
    </div>
  ))}
</div>

<script>
  const trigger = document.getElementById('theme-toggle') as HTMLButtonElement
  const menu = document.getElementById('theme-menu') as HTMLDivElement
  const items = [...menu.querySelectorAll<HTMLElement>('[role=menuitem]')]
  const media = window.matchMedia('(prefers-color-scheme: dark)')

  let isOpen = false

  // Same rules as the inline script in Main.astro: no stored value or
  // "system" follows the OS, which that script keeps listening to.
  function setTheme(theme: string) {
    try {
      localStorage.setItem('theme', theme)
    } catch {}
    const dark = theme === 'dark' || (theme === 'system' && media.matches)
    document.documentElement.classList.toggle('dark', dark)
  }

  // Bottom-end alignment with a 4px offset, like Radix's sideOffset={4}.
  function position() {
    const rect = trigger.getBoundingClientRect()
    menu.style.top = `${rect.bottom + 4}px`
    menu.style.left = `${Math.max(0, rect.right - menu.offsetWidth)}px`
  }

  function focusItem(item: HTMLElement | undefined) {
    item?.focus({ preventScroll: true })
  }

  function onPointerDownOutside(event: PointerEvent) {
    const target = event.target as Node
    if (!menu.contains(target) && !trigger.contains(target)) close(false)
  }

  function open(focus: 'menu' | 'first' | 'last') {
    if (isOpen) return
    isOpen = true
    trigger.dataset.state = 'open'
    trigger.setAttribute('aria-expanded', 'true')
    menu.dataset.state = 'open'
    if (!menu.matches(':popover-open')) menu.showPopover()
    position()
    window.addEventListener('scroll', position, {
      capture: true,
      passive: true,
    })
    window.addEventListener('resize', position)
    document.addEventListener('pointerdown', onPointerDownOutside, true)
    if (focus === 'first') focusItem(items[0])
    else if (focus === 'last') focusItem(items.at(-1))
    else menu.focus({ preventScroll: true })
  }

  function close(returnFocus: boolean) {
    if (!isOpen) return
    isOpen = false
    trigger.dataset.state = 'closed'
    trigger.setAttribute('aria-expanded', 'false')
    menu.dataset.state = 'closed'
    window.removeEventListener('scroll', position, { capture: true })
    window.removeEventListener('resize', position)
    document.removeEventListener('pointerdown', onPointerDownOutside, true)
    if (returnFocus) trigger.focus({ preventScroll: true })
    // Keep the menu in the top layer until the exit animation (150ms)
    // finishes; the timeout covers animations paused in background tabs.
    const hide = () => {
      if (!isOpen && menu.matches(':popover-open')) menu.hidePopover()
    }
    Promise.allSettled(menu.getAnimations().map((a) => a.finished)).then(hide)
    setTimeout(hide, 300)
  }

  function select(item: HTMLElement) {
    setTheme(item.dataset.theme!)
    close(true)
  }

  // Trigger: opens on press (not release), like Radix.
  trigger.addEventListener('pointerdown', (event) => {
    if (event.button !== 0 || event.ctrlKey) return
    if (isOpen) {
      close(true)
    } else {
      event.preventDefault()
      open('menu')
    }
  })

  trigger.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault()
      if (isOpen) close(true)
      else open('first')
    } else if (event.key === 'ArrowDown') {
      event.preventDefault()
      open('first')
    }
  })

  // Typeahead: typed characters jump to the matching item, reset after 1s.
  let search = ''
  let searchTimer: ReturnType<typeof setTimeout> | undefined

  function typeahead(key: string) {
    search += key
    clearTimeout(searchTimer)
    searchTimer = setTimeout(() => (search = ''), 1000)
    const repeated = [...search].every((char) => char === search[0])
    const query = (repeated ? search[0] : search).toLowerCase()
    const current = items.indexOf(document.activeElement as HTMLElement)
    const start = Math.max(current, 0)
    let candidates = [...items.slice(start), ...items.slice(0, start)]
    if (query.length === 1)
      candidates = candidates.filter((_, i) => i !== 0 || current === -1)
    focusItem(
      candidates.find((item) =>
        item.textContent!.trim().toLowerCase().startsWith(query),
      ),
    )
  }

  menu.addEventListener('keydown', (event) => {
    const current = items.indexOf(document.activeElement as HTMLElement)
    const { key } = event

    if (key === 'Tab') {
      event.preventDefault()
    } else if (key === 'Escape') {
      event.preventDefault()
      close(true)
    } else if (
      (key === 'Enter' || (key === ' ' && search === '')) &&
      current >= 0
    ) {
      event.preventDefault()
      select(items[current])
    } else if (
      ['ArrowDown', 'ArrowUp', 'Home', 'End', 'PageUp', 'PageDown'].includes(
        key,
      )
    ) {
      event.preventDefault()
      // No wrap-around at either end, matching Radix's default (loop=false).
      if (key === 'Home' || key === 'PageUp') focusItem(items[0])
      else if (key === 'End' || key === 'PageDown') focusItem(items.at(-1))
      else if (current === -1)
        focusItem(key === 'ArrowDown' ? items[0] : items.at(-1))
      else if (key === 'ArrowDown')
        focusItem(items[Math.min(current + 1, items.length - 1)])
      else focusItem(items[Math.max(current - 1, 0)])
    } else if (
      key.length === 1 &&
      !event.ctrlKey &&
      !event.altKey &&
      !event.metaKey
    ) {
      event.preventDefault()
      typeahead(key)
    }
  })

  // Close when focus leaves the menu for something other than the trigger.
  menu.addEventListener('focusout', (event) => {
    const next = event.relatedTarget as Node | null
    if (isOpen && next && !menu.contains(next) && next !== trigger) close(false)
  })

  for (const item of items) {
    // Mouse hover highlights by focusing, so `focus:` styles apply.
    item.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'mouse' && document.activeElement !== item)
        focusItem(item)
    })
    item.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse' && isOpen)
        menu.focus({ preventScroll: true })
    })
    // Select on release, so press-on-trigger, drag, release-on-item works.
    item.addEventListener('pointerup', (event) => {
      if (event.button === 0) select(item)
    })
  }
</script>
